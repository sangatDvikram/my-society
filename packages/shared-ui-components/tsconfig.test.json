{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["jest", "@testing-library/jest-dom"],
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true
  },
  "include": ["src/**/*", "jest.setup.ts"]
}
