{
  "name": "@society/shared-ui-components",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform UI component library — React (web) and React Native (mobile)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Covered by root eslint.config.mjs'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.(ts|tsx)$",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/../jest.setup.ts"
    ],
    "coverageDirectory": "../coverage",
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.spec.{ts,tsx}",
      "!**/*.d.ts",
      "!**/index.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testEnvironment": "jsdom"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "keywords": [
    "society",
    "ui",
    "components",
    "react",
    "react-native",
    "shared"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
