{
  "name": "@society/shared-ui-components",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform UI component library — React (web) and React Native (mobile)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Covered by root eslint.config.mjs'"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "keywords": [
    "society",
    "ui",
    "components",
    "react",
    "react-native",
    "shared"
  ],
  "license": "MIT"
}
