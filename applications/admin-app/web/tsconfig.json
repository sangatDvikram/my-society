{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  //
  // ─── admin-app / web (Next.js 15 + React 19 + Oat UI + Tailwind) ─────────
  // Admin-facing web dashboard: visitor management, maintenance triage,
  // facility approval, audit PDF workflow, vendor registry, announcement
  // broadcast, bank account verification, AdminJS panel.
  // ─────────────────────────────────────────────────────────────────────────
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@society/shared-ui-assets": [
        "../../../packages/shared-ui-assets/index.js"
      ],
      "@society/shared-types": [
        "../../../packages/shared-types/src"
      ],
      "@society/shared-validators": [
        "../../../packages/shared-validators/src"
      ],
      "@society/shared-ui-tokens": [
        "../../../packages/shared-ui-tokens"
      ],
      "@society/shared-ui-components": [
        "../../../packages/shared-ui-components/src"
      ],
      "@society/shared-i18n": [
        "../../../packages/shared-i18n/src"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
