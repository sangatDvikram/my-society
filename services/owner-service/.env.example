# =============================================================================
# owner-service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── TCP Microservice (NestJS Transport.TCP) ───────────────────────────────────
# api-gateway connects to this port to send messages via ClientProxy.
# Use a different port per service to avoid collision on the same host.
TCP_PORT=8877

# ── PostgreSQL (TypeORM) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=owner_service_db
DB_LOGGING=false
DB_SSL=false

# ── JWT (used for intra-service auth verification) ────────────────────────────
JWT_SECRET=replace-with-the-same-secret-as-api-gateway

# ── Razorpay (payment processing) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=society-media-dev

# ── BullMQ / Redis (background jobs) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
