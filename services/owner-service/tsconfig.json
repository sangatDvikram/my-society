{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  //
  // ─── owner-service (NestJS — CommonJS) ───────────────────────────────────
  // Owner-facing APIs: flats, maintenance, visitor logs, payments, rentals,
  // facility bookings, vendor directory, events, PDF statements, BullMQ jobs.
  // ─────────────────────────────────────────────────────────────────────────
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts", "**/*e2e-spec.ts"]
}
