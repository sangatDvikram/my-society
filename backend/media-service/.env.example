# =============================================================================
# media-service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3004

# ── PostgreSQL (TypeORM) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=media_service_db
DB_LOGGING=false
DB_SSL=false

# ── JWT (validated from api-gateway; shared secret) ───────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret

# ── AWS S3 — Event Media ──────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_EVENT_MEDIA=society-event-media
S3_BUCKET_RENTAL_DOCS=society-rental-documents
S3_BUCKET_VENDOR_DOCS=society-vendor-documents
S3_BUCKET_AUDIT_REPORTS=society-audit-reports

# Pre-signed URL expiry (seconds)
S3_PRESIGNED_PUT_TTL=900
S3_PRESIGNED_GET_TTL=3600

# ── AWS CloudFront CDN ────────────────────────────────────────────────────────
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# Path to PEM private key file for CloudFront signed cookies
CLOUDFRONT_PRIVATE_KEY_PATH=

# ── AWS KMS (S3 server-side encryption key) ───────────────────────────────────
AWS_KMS_KEY_ARN=arn:aws:kms:ap-south-1:000000000000:key/replace-me

# ── BullMQ (thumbnail + FFmpeg jobs) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Sharp / FFmpeg limits ─────────────────────────────────────────────────────
THUMBNAIL_WIDTH=480
THUMBNAIL_HEIGHT=480
VIDEO_FRAME_SECOND=1
