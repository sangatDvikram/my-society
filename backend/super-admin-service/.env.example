# =============================================================================
# super-admin-service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3003

# ── PostgreSQL (TypeORM) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=super_admin_service_db
DB_LOGGING=false
DB_SSL=false

# ── JWT (validated from api-gateway; shared secret) ───────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret

# ── TOTP 2FA (Super Admin second factor) ──────────────────────────────────────
TOTP_ISSUER=SocietyApp-SuperAdmin

# ── AdminJS Super Admin Panel ─────────────────────────────────────────────────
SUPER_ADMIN_PANEL_COOKIE_SECRET=replace-with-a-strong-random-secret
SUPER_ADMIN_PANEL_SESSION_TTL=28800

# ── Redis (AdminJS session store + feature flag cache) ────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AWS KMS (encryption key rotation) ────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ARN=arn:aws:kms:ap-south-1:000000000000:key/replace-me

# ── AWS Secrets Manager ───────────────────────────────────────────────────────
AWS_SECRETS_MANAGER_PREFIX=society/super-admin/
