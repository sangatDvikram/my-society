# =============================================================================
# super-admin-service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3003

# ── PostgreSQL (TypeORM) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=super_admin_service_db
DB_LOGGING=false
DB_SSL=false

# ── JWT (validated from api-gateway; shared secret) ───────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret

# ── TOTP 2FA (Super Admin second factor) ──────────────────────────────────────
TOTP_ISSUER=SocietyApp-SuperAdmin

# ── AdminJS Super Admin Panel (EPIC-15) ──────────────────────────────────────
# Served at /superadmin — Super Admin panel
ADMINJS_SESSION_SECRET=replace-with-a-strong-random-secret-min-32-chars
ADMINJS_COOKIE_SECRET=replace-with-another-strong-random-secret-min-32-chars
# Super Admin credentials (Email + Password; TOTP enforced as second factor)
SUPER_ADMIN_EMAIL=superadmin@yoursociety.app
SUPER_ADMIN_PASSWORD=replace-with-a-strong-hashed-password
# Legacy aliases kept for reference:
# SUPER_ADMIN_PANEL_COOKIE_SECRET=replace-with-a-strong-random-secret
# SUPER_ADMIN_PANEL_SESSION_TTL=28800

# ── Redis (AdminJS session store + feature flag cache; 8-hour TTL) ───────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Full Redis URL (overrides individual host/port/password if set):
# REDIS_URL=redis://localhost:6379

# ── AWS KMS (encryption key rotation) ────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ARN=arn:aws:kms:ap-south-1:000000000000:key/replace-me

# ── AWS Secrets Manager ───────────────────────────────────────────────────────
AWS_SECRETS_MANAGER_PREFIX=society/super-admin/
