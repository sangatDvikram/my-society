# =============================================================================
# api-gateway — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (TypeORM) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=api_gateway_db
DB_LOGGING=false
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP / 2FA ─────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
TOTP_ISSUER=SocietyApp

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Downstream microservice TCP endpoints ─────────────────────────────────────
# These are the TCP ports that each NestJS microservice listens on.
# Use the Kubernetes service DNS name in staging/production.
OWNER_SERVICE_HOST=localhost
OWNER_SERVICE_TCP_PORT=8877
ADMIN_SERVICE_HOST=localhost
ADMIN_SERVICE_TCP_PORT=8878
SUPER_ADMIN_SERVICE_HOST=localhost
SUPER_ADMIN_SERVICE_TCP_PORT=8879
MEDIA_SERVICE_HOST=localhost
MEDIA_SERVICE_TCP_PORT=8880

# ── AWS (for media-service presigned URLs via gateway) ────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
