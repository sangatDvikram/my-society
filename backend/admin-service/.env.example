# =============================================================================
# admin-service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002

# ── PostgreSQL (TypeORM) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=admin_service_db
DB_LOGGING=false
DB_SSL=false

# ── JWT (validated from api-gateway; shared secret) ───────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret

# ── AdminJS Panel ─────────────────────────────────────────────────────────────
ADMIN_PANEL_COOKIE_SECRET=replace-with-a-strong-random-secret
ADMIN_PANEL_SESSION_TTL=28800

# ── Redis (AdminJS session store) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
